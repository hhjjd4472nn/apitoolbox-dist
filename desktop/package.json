{
  "name": "apitoolbox-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "API Toolbox full Windows desktop application",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.coomi.apitoolbox.desktop",
    "productName": "API 工具箱",
    "asar": true,
    "directories": {"output": "dist"},
    "files": ["src/**/*", "renderer/**/*", "schema/**/*", "resources/**/*", "package.json"],
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}, {"target": "portable", "arch": ["x64"]}]},
    "nsis": {"artifactName": "ApiToolbox-Desktop-${version}-${arch}-setup.${ext}", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true},
    "portable": {"artifactName": "ApiToolbox-Desktop-${version}-${arch}-portable.${ext}"}
  }
}